{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(/Cargo.toml)"
    ],
    "deny": [
      "Edit(clippy.toml)",
      "Edit(.clippy.toml)",
      "Edit(rustfmt.toml)",
      "Edit(.rustfmt.toml)",
      "Edit(deny.toml)",
      "Edit(.deny.toml)",
      "Edit([Jj][Uu][Ss][Tt][Ff][Ii][Ll][Ee])",
      "Edit(.[Jj][Uu][Ss][Tt][Ff][Ii][Ll][Ee])",
      "Edit(rust-toolchain)",
      "Edit(rust-toolchain.toml)",
      "Edit(.cargo/**)",
      "Edit(/.githooks/**)",
      "Edit(/tests/behavior/**)",
      "Edit(/tests/behavior.rs)",
      "Edit(/AGENTS.md)",
      "Edit(/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_tests.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_tests.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_tests.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_tests.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compact_reinject.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
